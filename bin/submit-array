#!/usr/bin/env bash
# =============================================================================
# submit-array [options] TASKS...
#
# Submits a job array with one task per directory; each task runs
# lib/array_worker.sh in its directory, which runs the calculations there
# until converged (RUN_CMD, DONE_CMD, CALC_MARKER, CONVERGED_CMD, NEXT_CMD in
# the settings or options).
# TASKS is either one file listing the directories (one per line, '#' comments
# allowed, relative paths are relative to the file) or the directories.
#
# Options:
#   -c, --config FILE    project settings, repeatable (default: submit.conf
#                        in this folder and its parents, outermost first)
#   -P, --profile NAME   resource profile from the settings (e.g. main, shared)
#   -t, --time T         walltime of each task
#   -J, --job-name NAME  job name (default: JOB_NAME, else the directory name)
#   -x, --sched ARG      extra scheduler argument, repeatable (-x --mem=8G)
#   -p, --parallel N     at most N tasks running at once
#   -r, --run CMD        RUN_CMD, overriding the settings files
#   -d, --done CMD       DONE_CMD, overriding the settings files
#   -m, --marker FILE    CALC_MARKER, overriding the settings files
#   -a, --all            also submit tasks whose calculations are all done
#   -b, --backend NAME   slurm (default) or local (runs tasks one by one here)
#   -n, --dry-run        write and print the job script, do not submit
#   -h, --help
#
# Without NEXT_CMD, tasks whose calculations all pass DONE_CMD are left out,
# since they would only start and exit.
#
# Each submission gets a folder LOG_DIR/JOB_NAME_TIMESTAMP with the task list,
# settings, job script, a copy of the worker and one log per task, so editing
# the settings does not affect queued jobs. See README.md.
# =============================================================================

set -eo pipefail

self=$(realpath "$0" 2>/dev/null || echo "$0")
# shellcheck source=../lib/common.sh
source "$(dirname "$self")/../lib/common.sh"

WORKER_VARS=(RUN_CMD DONE_CMD CALC_MARKER CONVERGED_CMD NEXT_CMD
             MAX_RUNS MAX_FAILS WALLTIME)

unset "${WORKER_VARS[@]}"
OPT_RUN= OPT_DONE= OPT_MARKER=
ALL=0
TASKS=()
while (( $# )); do
    if common_opt "$@"; then
        shift "$NSHIFT"
    else
        case $1 in
            -p|--parallel) PARALLEL=${2-}; shift 2 ;;
            -r|--run)      OPT_RUN=${2-}; shift 2 ;;
            -d|--done)     OPT_DONE=${2-}; shift 2 ;;
            -m|--marker)   OPT_MARKER=${2-}; shift 2 ;;
            -a|--all)      ALL=1; shift ;;
            -*)            echo "Unknown option $1" >&2; usage 2 ;;
            *)             TASKS+=("$1"); shift ;;
        esac
    fi
done
(( ${#TASKS[@]} )) || usage 2

load_settings
[[ -n $OPT_RUN ]] && RUN_CMD=$OPT_RUN
[[ -n $OPT_DONE ]] && DONE_CMD=$OPT_DONE
[[ -n $OPT_MARKER ]] && CALC_MARKER=$OPT_MARKER
for v in RUN_CMD DONE_CMD CALC_MARKER; do
    if [[ -z ${!v:-} ]]; then
        read_from=$(describe_configs | tr '\n' ' ')
        (( ${#CONFIGS[@]} )) || read_from+="(no submit.conf in $PWD or its parents)"
        die "$v is not set; set it in a settings file or with an option. Settings read: ${read_from:-none}"
    fi
done
apply_setup_when "$RUN_CMD"

abs_dir() { (cd "$1" 2>/dev/null && pwd) || die "task directory '$1' not found."; }

# Succeeds if task dir $1 has a calc dir for which DONE_CMD fails.
has_pending() {
    local dir
    while IFS= read -r dir; do
        if ! (cd "$1/$dir" && TASK_DIR=$1 CALC_DIR=$PWD bash -c "$DONE_CMD") >/dev/null 2>&1; then
            return 0
        fi
    done < <(cd "$1" && find . -name "$CALC_MARKER" -not -path '*/.*/*' -exec dirname {} \;)
    return 1
}

task_dirs=()
if (( ${#TASKS[@]} == 1 )) && [[ -f ${TASKS[0]} ]]; then
    list_dir=$(cd "$(dirname "${TASKS[0]}")" && pwd)
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%%#*}
        line=$(echo "$line" | awk '{ $1 = $1; print }')
        [[ -z $line ]] && continue
        [[ $line == /* ]] || line=$list_dir/$line
        d=$(abs_dir "$line") || exit 1
        task_dirs+=("$d")
    done < "${TASKS[0]}"
else
    for t in "${TASKS[@]}"; do
        d=$(abs_dir "$t") || exit 1
        task_dirs+=("$d")
    done
fi
(( ${#task_dirs[@]} )) || die "no tasks given."

if [[ -z ${NEXT_CMD:-} ]] && (( ! ALL )); then
    ngiven=${#task_dirs[@]}
    pending=()
    for d in "${task_dirs[@]}"; do
        if has_pending "$d"; then
            pending+=("$d")
        fi
    done
    task_dirs=(${pending[@]+"${pending[@]}"})
    nskipped=$(( ngiven - ${#task_dirs[@]} ))
    if (( nskipped )); then
        echo "Skipped $nskipped of $ngiven task(s) with no unfinished calculations (--all to submit them)."
    fi
    (( ${#task_dirs[@]} )) || { echo "Nothing to submit."; exit 0; }
fi
ntasks=${#task_dirs[@]}

new_run_dir
printf '%s\n' "${task_dirs[@]}" > "$RUN_DIR/tasks"
cp "$LIB_DIR/array_worker.sh" "$RUN_DIR/array_worker.sh"
write_settings "${WORKER_VARS[@]}"
write_job "$(cat <<EOF
id=\${ARRAY_TASK_ID:-\${SLURM_ARRAY_TASK_ID:-\${PBS_ARRAY_INDEX:-\${SGE_TASK_ID:-\${LSB_JOBINDEX:-}}}}}
task=\$(sed -n "\${id}p" $(printf %q "$RUN_DIR/tasks"))
[[ -n \$task ]] || { echo "ERROR: no task for array index '\$id'"; exit 1; }
bash $(printf %q "$RUN_DIR/array_worker.sh") "\$task"
EOF
)"
echo "$ntasks task(s), job $JOB_NAME, backend $BACKEND, files in $RUN_DIR"
submit_job "$ntasks"
